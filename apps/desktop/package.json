{
  "name": "@chat/desktop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": ".electron/main.cjs",
  "description": "Enterprise contacts and chat desktop client",
  "author": "Enterprise Chat",
  "files": [
    ".electron/**",
    "dist/**",
    "forge.config.cjs"
  ],
  "scripts": {
    "predev": "pnpm build:main && pnpm rebuild:native",
    "dev": "concurrently -n renderer,electron -c green,cyan \"vite --host 127.0.0.1 --port 15173\" \"wait-on http://127.0.0.1:15173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:15173 electron .\"",
    "rebuild:native": "node scripts/prepare-native.mjs electron",
    "build:main": "node scripts/build-main.mjs",
    "clean:renderer": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build:renderer": "pnpm clean:renderer && tsc -b && vite build",
    "build": "pnpm build:main && pnpm build:renderer",
    "start": "electron .",
    "stage": "node scripts/prepare-package.mjs",
    "package": "pnpm build && node scripts/forge-release.mjs package",
    "make": "pnpm build && node scripts/forge-release.mjs make",
    "test": "node scripts/run-tests.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "electron-screenshots": "0.6.2"
  },
  "devDependencies": {
    "@chat/shared": "workspace:*",
    "@electron-forge/cli": "^7.10.2",
    "@electron-forge/maker-squirrel": "^7.10.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.10.2",
    "@hocuspocus/provider": "4.4.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.90.2",
    "@tiptap/extension-collaboration": "3.29.2",
    "@tiptap/extension-collaboration-caret": "3.29.2",
    "@tiptap/extension-highlight": "3.29.2",
    "@tiptap/extension-table": "3.29.2",
    "@tiptap/extension-text-align": "3.29.2",
    "@tiptap/pm": "3.29.2",
    "@tiptap/react": "3.29.2",
    "@tiptap/starter-kit": "3.29.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "antd": "^6.5.2",
    "axios": "^1.18.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "dompurify": "^3.4.12",
    "electron": "^42.0.0",
    "emoji-picker-react": "^4.19.1",
    "esbuild": "^0.25.11",
    "less": "^4.8.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4",
    "socket.io-client": "^2.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4",
    "wait-on": "^9.0.1",
    "yjs": "13.6.27",
    "zustand": "^5.0.8"
  }
}
